# Copia este archivo a .env y cambia los valores. .env NUNCA se sube a git.

# --- API ---
# URL pública del backend. Es la ÚNICA forma de llamarlo: desde el navegador y desde el servidor de Next
# (SSR, route handlers, proxy). Se fija al COMPILAR (va dentro del JavaScript que descarga el navegador):
# si la cambias, hay que reconstruir la imagen (en el servidor, el siguiente deploy lo hace).
#   desarrollo: http://localhost:4000
#   staging:    https://api-staging.giadministracion.com
#   producción: https://api.giadministracion.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Dominio ---
# Dominio base del entorno: admin.BASE_DOMAIN, app.BASE_DOMAIN y <slug>.BASE_DOMAIN para cada empresa.
# Cada entorno tiene su propio dominio con comodín (*), así que las empresas nuevas funcionan sin tocar DNS.
#   desarrollo: localhost  (abre http://admin.localhost:3000, http://app.localhost:3000, http://<slug>.localhost:3000)
#   staging:    globalbig.com.mx
#   producción: giadministracion.com
BASE_DOMAIN=localhost

# --- Solo en el servidor (staging / producción) ---
# Nombre del proyecto Docker de este entorno. El deploy verifica que coincida con la carpeta.
#   ~/Documents/ERP-FrontEnd          -> COMPOSE_PROJECT_NAME=erp-front-production
#   ~/Documents/staging/ERP-FrontEnd  -> COMPOSE_PROJECT_NAME=erp-front-staging
#COMPOSE_PROJECT_NAME=
# Puerto en 127.0.0.1 del servidor y alias del frontend en gama-net.
# En desarrollo no hace falta definirlos (se usan 4200 / erp-frontend).
#   producción: FRONTEND_PORT=4200  FRONTEND_ALIAS=erp-frontend
#   staging:    FRONTEND_PORT=4201  FRONTEND_ALIAS=erp-frontend-staging
#FRONTEND_PORT=
#FRONTEND_ALIAS=
